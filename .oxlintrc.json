{
  "ignorePatterns": ["reports/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "never" }
    ],
    "typescript/no-explicit-any": "error",
    "no-await-in-loop": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/require-post-message-target-origin": "off",
    "unicorn/prefer-add-event-listener": "off",
    // The rule suggests Object.assign, which this project bans; object spread is the chosen form.
    "oxc/no-map-spread": "off",
    "no-underscore-dangle": [
      "error",
      { "allow": ["_getBlockers", "_option", "__resetForTest"] }
    ],
    // These stubs must be constructible but only throw; they are not static-only utility classes.
    "typescript/no-extraneous-class": [
      "error",
      { "allowConstructorOnly": true }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "Object",
        "property": "assign",
        "message": "Use object spread instead of Object.assign."
      },
      {
        "object": "Object",
        "property": "defineProperty",
        "message": "Define the value where it is created, or use vi.stubGlobal in tests."
      },
      {
        "object": "Object",
        "property": "defineProperties",
        "message": "Define the values where they are created, or use vi.stubGlobal in tests."
      },
      {
        "object": "Object",
        "property": "create",
        "message": "Use an object literal or a Map instead of Object.create."
      },
      {
        "object": "Object",
        "property": "setPrototypeOf",
        "message": "Do not change an object's prototype."
      },
      {
        "object": "Object",
        "property": "freeze",
        "message": "Keep immutability in types instead of freezing at runtime."
      },
      {
        "object": "Object",
        "property": "seal",
        "message": "Do not lock objects at runtime."
      },
      {
        "object": "Object",
        "property": "preventExtensions",
        "message": "Do not lock objects at runtime."
      },
      {
        "object": "Object",
        "property": "getOwnPropertyDescriptor",
        "message": "Use a typed fixture or vi.stubGlobal instead of reading a property descriptor."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": { "no-shadow": "off" }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": { "no-underscore-dangle": "off" }
    }
  ]
}
