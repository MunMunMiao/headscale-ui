{
  "name": "headscale-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "bun check",
    "build": "bun run typecheck && vite build",
    "lint": "biome check .",
    "test": "vitest run --coverage",
    "test:docker": "bun scripts/run-e2e.ts && bun scripts/check-policy-lifecycle.ts && bun scripts/check-session.ts && bun scripts/check-deployment.ts",
    "verify:ci": "bun run --parallel lint typecheck && bun run i18n:check && bun run test && bun run build",
    "verify": "bun run verify:ci && bun run test:docker",
    "browser:install": "playwright install --with-deps chromium",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "i18n:check": "bun run --check scripts/check-i18n.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@defjs/core": "0.4.0-beta.1",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@tanstack/react-router": "1.170.42",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.2",
    "idb": "8.0.4",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lingui/cli": "6.9.1",
    "@lingui/conf": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "bun-types": "1.4.3",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.64.0",
    "shadcn": "4.21.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  }
}
