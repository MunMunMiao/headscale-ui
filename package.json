{
  "name": "headscale-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "bun check",
    "build": "bun run typecheck && vite build",
    "lint": "oxlint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "vitest run --coverage",
    "e2e": "bun scripts/run-e2e.ts && bun scripts/check-policy-lifecycle.ts && bun scripts/check-session.ts && bun scripts/check-deployment.ts",
    "browser:install": "playwright install --with-deps chromium",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "posti18n:compile": "bun fmt src/i18n/locales",
    "i18n:check": "bun run --check scripts/check-i18n.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@defjs/core": "0.4.0-beta.1",
    "@lingui/core": "6.10.1",
    "@lingui/react": "6.10.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "effect": "4.0.7",
    "idb": "8.0.4",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@lingui/cli": "6.10.1",
    "@lingui/conf": "6.10.1",
    "@lingui/format-po": "6.10.1",
    "@lingui/vite-plugin": "6.10.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "bun-types": "1.4.4",
    "fake-indexeddb": "6.2.6",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  }
}
